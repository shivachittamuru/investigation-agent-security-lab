# Microsoft Foundry
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.2
AZURE_AI_ADVANCED_MODEL_DEPLOYMENT_NAME=gpt-5.6-sol

# Model inference
