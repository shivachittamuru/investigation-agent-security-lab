# Security configuration
ENTRA_TENANT_ID=<your-directory-tenant-id>
ENTRA_API_CLIENT_ID=<api-client-id>
ENTRA_CLIENT_ID=<notebook-client-application-id>
ENTRA_LAB_USER_OID=